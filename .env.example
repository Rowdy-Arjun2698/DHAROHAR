# Copied to .env only when .env does not already exist. Keep .env private.
AI_PROVIDER=local
LOCAL_LLM_URL=http://127.0.0.1:8011
VOICE_PROVIDER=local
TTS_ENGINE=piper
TRANSLATION_PROVIDER=local

# Optional cloud providers. Setting these values does not activate them.
# To use Sarvam, set AI_PROVIDER, VOICE_PROVIDER and/or TRANSLATION_PROVIDER=sarvam.
# Cloud mode sends the relevant question/source excerpts or voice audio to Sarvam.
SARVAM_API_KEY=
SARVAM_CHAT_MODEL=sarvam-105b-conversations
SARVAM_CONVERSATION_MODEL=sarvam-105b-conversations
SARVAM_REVIEW_MODEL=sarvam-105b
